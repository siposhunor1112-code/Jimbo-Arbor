# Az oldal nyilvános címe (élesben https://...). A visszairányítások és a CSRF-védelem ezt használja.
BASE_URL=http://localhost:3000
PORT=3000

# Itt tárolódik az adatbázis (app.db) és a feltöltött sablonfájlok. Élesben tartós lemez kell.
DATA_DIR=./data

# 1 = fordított proxy (pl. Render, Railway, Nginx) mögött fut az alkalmazás
TRUST_PROXY=0

# Megjelenés
SITE_NAME=Sablontár
AUDIENCE=fodrászoknak
PRICE_LABEL=4 990 Ft / hó

# Ezekkel az e-mail-címekkel regisztrált fiókok tölthetnek fel sablont (vesszővel elválasztva)
ADMIN_EMAILS=te@example.com

# Stripe (Dashboard → Developers → API keys; tesztmódban sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# A havi termék ára (Dashboard → Product catalog → az ár azonosítója: price_...)
STRIPE_PRICE_ID=price_...
# A webhook végpont titka (Dashboard → Developers → Webhooks, vagy a `stripe listen` kiírja)
STRIPE_WEBHOOK_SECRET=whsec_...
